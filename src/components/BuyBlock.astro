---
import Button from './Button.astro';
import type { Book } from '../lib/books';

interface Props {
  buy: Book['data']['buy'];
  ebookPrice?: number;
}
const { buy, ebookPrice } = Astro.props;
const ebooks = buy.ebooks ? Object.entries(buy.ebooks) : [];
---

<section id="buy" class="buy" aria-labelledby="buy-title">
  <h2 id="buy-title" class="buy__title">哪裡買</h2>
  {buy.note && <p class="buy__note">{buy.note}</p>}
  <div class="buy__links">
    {
      buy.links.map((l) => (
        <Button href={l.href} variant={l.style} block>
          {l.label}
        </Button>
      ))
    }
  </div>
  {
    ebooks.length > 0 && (
      <div class="ebooks">
        <h3 class="ebooks__head">
          <span>電子書</span>
          {ebookPrice && <span class="ebooks__price">NT${ebookPrice}</span>}
        </h3>
        <ul class="ebooks__grid">
          {ebooks.map(([name, href]) => (
            <li>
              <a class="ebooks__store" href={href}>
                {name}
                <span class="ebooks__arrow" aria-hidden="true">⇀</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
  {
    buy.crowdfunding && (
      <p class="buy__crowd">
        {buy.crowdfunding.note}
        <a class="text-link" href={buy.crowdfunding.href}>
          {buy.crowdfunding.label}
        </a>
      </p>
    )
  }
</section>

<style>
  .buy {
    display: flex;
    flex-direction: column;
    gap: 12px;
    scroll-margin-top: 24px;
  }

  .buy__title {
    margin-bottom: 4px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 18px;
    line-height: 1.5;
    letter-spacing: 0.24em;
  }

  .buy__note {
    margin-bottom: 6px;
    font-size: var(--fs-small);
    line-height: 1.9;
    letter-spacing: var(--ls-body);
    color: var(--color-body);
  }

  .buy__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* 電子書：小標接一條細線，下面是一格一格的書店 */
  .ebooks {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ebooks__head {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--fs-small);
    line-height: 1.5;
    letter-spacing: 0.2em;
  }

  .ebooks__head::after {
    content: '';
    flex: 1 1 auto;
    height: 1px;
    background: var(--color-rule);
  }

  .ebooks__price {
    order: 2;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--fs-caption);
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .ebooks__head::after {
    order: 1;
  }

  .ebooks__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ebooks__store {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: var(--button-h);
    padding: 0 16px;
    border: 1px solid var(--color-rule);
    background: var(--color-white);
    font-size: var(--fs-ui);
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--color-ink);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .ebooks__store:hover {
    border-color: var(--color-ink);
    background: var(--color-panel);
    color: var(--color-ink);
  }

  .ebooks__arrow {
    color: var(--color-gold);
  }

  .buy__crowd {
    margin-top: 4px;
    font-size: var(--fs-caption);
    line-height: 1.8;
    color: var(--color-muted);
  }

  .buy__crowd a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--color-muted);
  }

  .buy__crowd a:hover {
    color: var(--color-gold-text);
  }

  @media (min-width: 900px) {
    .ebooks__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 599px) {
    .buy__crowd {
      text-align: center;
    }
  }
</style>
