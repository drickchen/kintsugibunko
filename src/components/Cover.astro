---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** 顯示寬度上限（CSS px），用來決定輸出的圖片尺寸 */
  width: number;
  sizes?: string;
  shadow?: 'lg' | 'md' | 'sm';
  eager?: boolean;
  class?: string;
}
const { src, alt, width, sizes, shadow = 'md', eager = false, class: className } = Astro.props;

// 一倍與兩倍螢幕各一張，不超過原圖寬度
const widths = [...new Set([width, width * 2].map((w) => Math.min(w, src.width)))];
---

<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes ?? `${width}px`}
  formats={['webp']}
  fallbackFormat="jpg"
  quality={82}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  class:list={['cover', `cover--${shadow}`, className]}
/>

<style>
  .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 631 / 891;
    object-fit: cover;
  }

  .cover--lg {
    box-shadow: var(--shadow-cover-lg);
  }

  .cover--md {
    box-shadow: var(--shadow-cover-md);
  }

  .cover--sm {
    box-shadow: var(--shadow-cover-sm);
  }
</style>
