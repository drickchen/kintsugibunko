---
interface Props {
  href: string;
  /** primary：深色底加金色箭頭；secondary：深色線框；underline：金色底線文字連結 */
  variant?: 'primary' | 'secondary' | 'underline';
  arrow?: boolean;
  /** 手機寬度時撐滿整行 */
  block?: boolean;
}
const { href, variant = 'primary', arrow = variant === 'primary', block = false } = Astro.props;
---

<a class:list={['btn', `btn--${variant}`, { 'btn--block': block }]} href={href}>
  <slot />{arrow && <span class="btn__arrow" aria-hidden="true">⇀</span>}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: var(--button-h);
    font-size: 15px;
    letter-spacing: 0.14em;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .btn--primary {
    padding: 0 26px;
    background: var(--color-ink);
    color: var(--color-page);
  }

  .btn--primary:hover {
    background: #3a3630;
    color: var(--color-page);
  }

  .btn--secondary {
    padding: 0 26px;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
  }

  .btn--secondary:hover {
    background: var(--color-panel);
    color: var(--color-ink);
  }

  .btn--underline {
    letter-spacing: 0.12em;
    border-bottom: 1px solid var(--color-gold);
  }

  .btn__arrow {
    color: var(--color-gold);
  }

  .btn--block {
    min-height: 52px;
  }

  @media (max-width: 599px) {
    .btn--block {
      display: flex;
      width: 100%;
    }
  }
</style>
